{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"],
    "module": "NodeNext", "moduleResolution": "NodeNext",
    "noEmit": true, "allowImportingTsExtensions": true,
    "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "useUnknownInCatchVariables": true,
    "noFallthroughCasesInSwitch": true, "noImplicitOverride": true,
    "verbatimModuleSyntax": true, "erasableSyntaxOnly": true,
    "types": ["node"], "skipLibCheck": false
  },
  "include": ["src/**/*.ts"]
}
